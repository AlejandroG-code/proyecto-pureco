# ==========================================
# Configuración del Backend (Local o Railway)
# ==========================================
PORT=3001

# Conexión MySQL local o remota
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clickgo

# Activar SSL en caso de base de datos en la nube que lo requiera (ej. TiDB o Aiven):
DB_SSL=false

# Nota Railway: Al vincular el plugin de MySQL en Railway, las variables 
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE
# son reconocidas automáticamente.

# ==========================================
# Configuración del Frontend (Vercel)
# ==========================================
# En Vercel, agrega esta variable con la URL pública generada por Railway (sin barra final):
# VITE_API_URL=https://tu-backend.up.railway.app
